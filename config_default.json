{
    "config_version": 2,
    "general": {
        "language": "en",
        "send_channel_messages": true,
        "cache_file_name": "TTMediaBotCache.dat",
        "blocked_commands": [],
        "delete_uploaded_files_after": 300,
        "time_format": "%H:%M",
        "start_commands": [],
        "search_results_mode": false
    },
    "player": {
        "default_volume": 50,
        "max_volume": 100,
        "volume_fading": true,
        "volume_fading_interval": 0.025,
        "seek_step": 5,
        "ffmpeg_path": "",
        "buffer_seconds": 5.0,
        "network_timeout": 30.0,
        "volume_curve": "cubic",
        "fade_out_on_stop": true,
        "fade_out_duration": 3.0
    },
    "teamtalk": {
        "hostname": "localhost",
        "tcp_port": 10333,
        "udp_port": 10333,
        "encrypted": false,
        "nickname": "TTMediaBot",
        "status": "",
        "gender": "n",
        "username": "",
        "password": "",
        "channel": "/",
        "channel_password": "",
        "license_name": "",
        "license_key": "",
        "reconnection_attempts": -1,
        "reconnection_timeout": 10,
        "users": {
            "admins": [
                "admin"
            ],
            "banned_users": []
        },
        "event_handling": {
            "load_event_handlers": false,
            "event_handlers_file_name": "event_handlers.py"
        }
    },
    "services": {
        "default_service": "yt",
        "yt": {
            "enabled": true,
            "cookiefile_path": "",
            "search_results": 1
        },
        "ytm": {
            "enabled": true,
            "search_results": 1
        }
    },
    "logger": {
        "log": true,
        "level": "INFO",
        "format": "%(levelname)s [%(asctime)s]: %(message)s in %(threadName)s file: %(filename)s line %(lineno)d function %(funcName)s",
        "mode": "FILE",
        "file_name": "TTMediaBot.log",
        "max_file_size": 0,
        "backup_count": 0
    },
    "shortening": {
        "shorten_links": false,
        "service": "clckru",
        "service_params": {}
    },
    "updater": {
        "enabled": true,
        "check_interval_minutes": 60,
        "remote": "origin"
    },
    "ai": {
        "enabled": true,
        "provider": "gemini",
        "cooldown_seconds": 2.0,
        "max_question_length": 2000,
        "max_answer_length": 1500,
        "show_sources": true,
        "chat_idle_minutes": 30,
        "max_concurrent_requests": 3,
        "gemini": {
            "api_key": "",
            "model": "gemini-3.8-flash",
            "google_search": true,
            "thinking_level": "low",
            "timeout_seconds": 60.0,
            "max_retries": 2,
            "system_instruction": ""
        }
    }
}